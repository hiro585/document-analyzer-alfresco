# Copy this file to .env and adjust as needed: cp .env.example .env

# Backend port
PORT=3001

# Ollama server
OLLAMA_URL=http://localhost:11434

# Alfresco export (optional — only needed for the "Export to Alfresco" feature)
ALFRESCO_URL=http://localhost:8080/alfresco/api/-default-/public/alfresco/versions/1
ALFRESCO_USERNAME=admin
ALFRESCO_PASSWORD=change-me
# Alfresco site to export to and browse (default: demo)
# ALFRESCO_SITE=demo
# Search API endpoint; only needed if your server uses a non-standard path
# ALFRESCO_SEARCH_URL=http://localhost:8080/alfresco/api/-default-/public/search/versions/1/search
